# ── 业务 JWT ──
JWT_SECRET=change-me-strong-secret
JWT_ALGORITHM=HS256
# ── 内部 JWT（MCP 工具调用业务接口时签发，60s 有效）──
INTERNAL_JWT_SECRET=change-me-internal-secret
INTERNAL_JWT_TTL_SECONDS=60
# ── MCP 对外地址（由部署方提供，不探测本机 IP）──
MCP_PUBLIC_BASE_URL=https://feature-platform.internal
MCP_AUTHORIZATION_SERVERS=["https://auth.feature-platform.internal"]
